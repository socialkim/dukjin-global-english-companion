{
  "manifest_version": 3,
  "name": "Dukjin Global — AI Subtitle Companion",
  "version": "0.2.0",
  "minimum_chrome_version": "138",
  "description": "Capture, translate, summarize and navigate Korean YouTube broadcasts with on-device AI or your own secure OpenAI connection.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://api.openai.com/*"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Dukjin Global"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
